generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Mobile {
  id          String   @id @default(cuid())
  brand       String   // in text
  model       String   // in text
  ram         Int      // in GB
  storage     Int      // in GB
  screenSize  Float    // in inches
  frontCamera Int      // main camera in MP
  rearCamera  Int      // back camera in MP
  battery     Int      // in mAh
  processor   String   // in text
  price       Float    // actual price
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brand])
  @@index([price])
}

model Prediction {
  id             String   @id @default(cuid())
  brand          String   // in text
  model          String   // in text
  ram            Int      // in GB
  storage        Int      // in GB
  screenSize     Float    // in inches
  frontCamera    Int      // main camera in MP
  rearCamera     Int      // back camera in MP
  battery        Int      // in percentage
  processor      String   // in text
  predictedPrice Float    // in rupees
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
